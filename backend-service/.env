# ==========================================================
# KONFIGURASI FIREBASE (Service Account)
# Ambil dari Firebase Console > Project Settings > Service Accounts
# > Generate New Private Key. JANGAN commit file ini ke git.
# ==========================================================
FIREBASE_PROJECT_ID=smartcoldstorage-69780
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@smartcoldstorage-69780.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nISI_PRIVATE_KEY_DISINI\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://smartcoldstorage-69780-default-rtdb.asia-southeast1.firebasedatabase.app

# ==========================================================
# KONFIGURASI CLEANUP
# ==========================================================
# Berapa hari data history disimpan sebelum dihapus otomatis
RETENTION_DAYS=40

# Jadwal cron (format standar cron: menit jam tanggal bulan hari)
# Default: setiap hari jam 00:05
CRON_SCHEDULE="5 0 * * *"

# ==========================================================
# KONFIGURASI SERVER (Health Check)
# ==========================================================
PORT=3000
